      "type": "u",
      "definition": "UNIQUE (avatar_attachment_id)"
    },
    {
      "table": "users",
      "name": "users_display_name_check",
      "type": "c",
      "definition": "CHECK ((((length(display_name) \u003e= 1) AND (length(display_name) \u003c= 64)) AND (display_name ~ '[^[:space:]]'::text)))"
    },
    {
      "table": "users",
      "name": "users_identifier_check",
      "type": "c",
      "definition": "CHECK ((((length(identifier) \u003e= 1) AND (length(identifier) \u003c= 254)) AND (identifier = lower(identifier))))"
    },
    {
      "table": "users",
      "name": "users_identifier_key",
      "type": "u",
      "definition": "UNIQUE (identifier)"
    },
    {
      "table": "users",
      "name": "users_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    }
  ],
  "indexes": [
    {
