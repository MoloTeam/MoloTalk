  "constraints": [
    {
      "table": "attachments",
      "name": "attachments_channel_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (channel_id) REFERENCES channels(id)"
    },
    {
      "table": "attachments",
      "name": "attachments_check",
      "type": "c",
      "definition": "CHECK (((purpose \u003c\u003e 'AVATAR'::text) OR (size_bytes \u003c= 5242880)))"
    },
    {
      "table": "attachments",
      "name": "attachments_check1",
      "type": "c",
      "definition": "CHECK (((purpose \u003c\u003e 'MESSAGE_ATTACHMENT'::text) OR (size_bytes \u003c= 20971520)))"
    },
    {
      "table": "attachments",
      "name": "attachments_check2",
      "type": "c",
      "definition": "CHECK (((channel_id IS NULL) = (linked_at IS NULL)))"
    },
    {
      "table": "attachments",
      "name": "attachments_object_key_key",
      "type": "u",
      "definition": "UNIQUE (object_key)"
    },
    {
      "table": "attachments",
      "name": "attachments_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "attachments",
      "name": "attachments_purpose_check",
      "type": "c",
      "definition": "CHECK ((purpose = ANY (ARRAY['AVATAR'::text, 'MESSAGE_ATTACHMENT'::text])))"
    },
    {
      "table": "attachments",
      "name": "attachments_size_bytes_check",
      "type": "c",
      "definition": "CHECK ((size_bytes \u003e= 0))"
    },
    {
      "table": "attachments",
      "name": "attachments_status_check",
      "type": "c",
      "definition": "CHECK ((status = ANY (ARRAY['UPLOADING'::text, 'VALIDATING'::text, 'READY'::text, 'REJECTED'::text, 'DELETING'::text])))"
    },
    {
      "table": "attachments",
      "name": "attachments_temp_object_key_key",
      "type": "u",
      "definition": "UNIQUE (temp_object_key)"
    },
    {
      "table": "attachments",
      "name": "attachments_uploader_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (uploader_id) REFERENCES users(id)"
    },
    {
      "table": "channel_members",
      "name": "channel_members_channel_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (channel_id) REFERENCES channels(id)"
    },
    {
      "table": "channel_members",
      "name": "channel_members_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (channel_id, user_id)"
    },
    {
      "table": "channel_members",
      "name": "channel_members_role_check",
      "type": "c",
      "definition": "CHECK ((role = ANY (ARRAY['ADMIN'::text, 'MEMBER'::text])))"
    },
    {
      "table": "channel_members",
      "name": "channel_members_user_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (user_id) REFERENCES users(id)"
    },
    {
      "table": "channels",
      "name": "channels_check",
      "type": "c",
      "definition": "CHECK ((((kind = 'DIRECT'::text) AND (client_request_id IS NULL) AND (create_request_hash IS NULL)) OR ((kind = 'GROUP'::text) AND (client_request_id IS NOT NULL) AND (create_request_hash IS NOT NULL))))"
    },
    {
      "table": "channels",
      "name": "channels_check1",
      "type": "c",
      "definition": "CHECK ((((kind = 'DIRECT'::text) AND (owner_id IS NULL) AND (direct_pair_key IS NOT NULL)) OR ((kind = 'GROUP'::text) AND (direct_pair_key IS NULL) AND ((closed_at IS NOT NULL) OR ((owner_id IS NOT NULL) AND (name IS NOT NULL) AND (name ~ '[^[:space:]]'::text))))))"
    },
    {
      "table": "channels",
      "name": "channels_created_by_id_client_request_id_key",
      "type": "u",
      "definition": "UNIQUE (created_by_id, client_request_id)"
    },
    {
      "table": "channels",
      "name": "channels_created_by_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (created_by_id) REFERENCES users(id)"
    },
    {
      "table": "channels",
      "name": "channels_direct_pair_key_key",
      "type": "u",
      "definition": "UNIQUE (direct_pair_key)"
    },
    {
      "table": "channels",
      "name": "channels_kind_check",
      "type": "c",
      "definition": "CHECK ((kind = ANY (ARRAY['DIRECT'::text, 'GROUP'::text])))"
    },
    {
      "table": "channels",
      "name": "channels_name_check",
      "type": "c",
      "definition": "CHECK (((length(name) \u003e= 1) AND (length(name) \u003c= 100)))"
    },
    {
      "table": "channels",
      "name": "channels_owner_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (owner_id) REFERENCES users(id)"
    },
    {
      "table": "channels",
      "name": "channels_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "channels",
      "name": "group_owner_is_member",
      "type": "f",
      "definition": "FOREIGN KEY (id, owner_id) REFERENCES channel_members(channel_id, user_id) DEFERRABLE INITIALLY DEFERRED"
    },
    {
      "table": "login_attempt_windows",
      "name": "login_attempt_windows_failed_count_check",
      "type": "c",
      "definition": "CHECK (((failed_count \u003e= 1) AND (failed_count \u003c= 5)))"
    },
    {
      "table": "login_attempt_windows",
      "name": "login_attempt_windows_identifier_hash_check",
      "type": "c",
      "definition": "CHECK ((identifier_hash ~ '^[0-9a-f]{64}$'::text))"
    },
    {
      "table": "login_attempt_windows",
      "name": "login_attempt_windows_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (identifier_hash)"
    },
    {
      "table": "message_receipts",
      "name": "message_receipts_check",
      "type": "c",
      "definition": "CHECK (((read_at IS NULL) OR ((delivered_at IS NOT NULL) AND (read_at \u003e= delivered_at))))"
    },
    {
      "table": "message_receipts",
      "name": "message_receipts_message_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (message_id) REFERENCES messages(id)"
    },
    {
      "table": "message_receipts",
      "name": "message_receipts_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (message_id, user_id)"
    },
    {
      "table": "message_receipts",
      "name": "message_receipts_user_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (user_id) REFERENCES users(id)"
    },
    {
      "table": "messages",
      "name": "messages_attachment_ids_check",
      "type": "c",
      "definition": "CHECK ((cardinality(attachment_ids) \u003c= 5))"
    },
    {
      "table": "messages",
      "name": "messages_author_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (author_id) REFERENCES users(id)"
    },
    {
      "table": "messages",
      "name": "messages_channel_id_author_id_client_message_id_key",
      "type": "u",
      "definition": "UNIQUE (channel_id, author_id, client_message_id)"
    },
    {
      "table": "messages",
      "name": "messages_channel_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (channel_id) REFERENCES channels(id)"
    },
    {
      "table": "messages",
      "name": "messages_check",
      "type": "c",
      "definition": "CHECK (((deleted_at IS NOT NULL) OR (text ~ '[^[:space:]]'::text) OR (cardinality(attachment_ids) \u003e 0)))"
    },
    {
      "table": "messages",
      "name": "messages_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "messages",
      "name": "messages_revision_check",
      "type": "c",
      "definition": "CHECK ((revision \u003e= 1))"
    },
    {
      "table": "messages",
      "name": "messages_text_check",
      "type": "c",
      "definition": "CHECK ((char_length(text) \u003c= 4096))"
    },
    {
      "table": "refresh_tokens",
      "name": "refresh_tokens_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (token_hash)"
    },
    {
      "table": "refresh_tokens",
      "name": "refresh_tokens_session_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (session_id) REFERENCES sessions(id)"
    },
    {
      "table": "sessions",
      "name": "sessions_check",
      "type": "c",
      "definition": "CHECK ((expires_at \u003e created_at))"
    },
    {
      "table": "sessions",
      "name": "sessions_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "sessions",
      "name": "sessions_user_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (user_id) REFERENCES users(id)"
    },
    {
      "table": "user_auth",
      "name": "user_auth_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (user_id)"
    },
    {
      "table": "user_auth",
      "name": "user_auth_user_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (user_id) REFERENCES users(id)"
    },
    {
      "table": "users",
      "name": "user_avatar_fk",
      "type": "f",
      "definition": "FOREIGN KEY (avatar_attachment_id) REFERENCES attachments(id)"
    },
    {
      "table": "users",
