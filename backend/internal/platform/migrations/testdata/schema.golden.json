    },
    {
      "table": "message_receipts",
      "name": "receipt_unread_idx",
      "definition": "CREATE INDEX receipt_unread_idx ON public.message_receipts USING btree (user_id, message_id) WHERE (read_at IS NULL)"
    },
    {
      "table": "message_receipts",
      "name": "receipt_user_idx",
      "definition": "CREATE INDEX receipt_user_idx ON public.message_receipts USING btree (user_id, message_id)"
    },
    {
