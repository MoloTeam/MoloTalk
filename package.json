{
  "name": "molotalk",
  "private": true,
  "description": "MoloTalk: контракты, веб-клиент и локальное окружение",
  "engines": {
    "node": ">=24.11.1",
    "npm": ">=11"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "generate": "npm run generate --workspace api",
    "check:api": "npm run check --workspace api",
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "lint": "npm run lint --workspace web",
    "typecheck": "npm run typecheck --workspace web",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-web": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "5.9.3"
  }
}
