# Настройки HTTP-слушателей. Значения по умолчанию указаны после знака «=».
# Адрес слушателя по умолчанию — 127.0.0.1.
HTTP_HOST=127.0.0.1

# Порты процессов, допустимый диапазон — от 1 до 65535.
AUTH_HTTP_PORT=8081
CHAT_HTTP_PORT=8082
MEDIA_HTTP_PORT=8083
PRESENCE_HTTP_PORT=8084
GATEWAY_HTTP_PORT=8085

# Общий бюджет одного запроса готовности, от 100ms до 5s включительно.
READINESS_TIMEOUT=1s

# Путь к PKCS#8 Ed25519 ключу подписи access JWT. Файл создаётся отдельно и
# не хранится в репозитории; см. README «Ключ подписи Auth».
AUTH_JWT_SIGNING_KEY_PATH=./deploy/data/auth-jwt-signing-key.pem

# --- Контейнерное окружение (Docker Compose) ---
# Значения ниже предназначены только для локального запуска и являются
# тестовыми. Для личных настроек используйте отдельный файл `.env`.

# Внешний HTTPS-порт Caddy. Публикуется только на loopback.
HTTPS_PORT=443

# Прямой S3-доступ к MinIO. Публикуется только на loopback.
MINIO_S3_PORT=9000

# PostgreSQL
POSTGRES_USER=molotalk
POSTGRES_PASSWORD=molotalk-test-password
POSTGRES_DB=molotalk

# MinIO
MINIO_ROOT_USER=molotalk
MINIO_ROOT_PASSWORD=molotalk-test-secret
MINIO_BUCKET=molotalk
