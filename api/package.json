{
  "name": "molotalk-api",
  "private": true,
  "description": "Proto contracts, generated TypeScript and OpenAPI for MoloTalk",
  "scripts": {
    "buf": "buf",
    "generate:go": "buf generate --template buf.gen.go.yaml",
    "generate:ts": "buf generate --template buf.gen.ts.yaml --path proto/molotalk/v1",
    "generate:openapi": "buf generate --template buf.gen.openapi.yaml",
    "generate": "npm run generate:go && npm run generate:ts && npm run generate:openapi",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/test/*.test.ts",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-web": "2.3.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@bufbuild/protovalidate": "1.3.0",
    "typescript": "5.9.3"
  }
}
