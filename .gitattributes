# Окончания строк: в репозитории хранится LF, рабочая копия на Windows тоже LF.
* text=auto eol=lf

*.go text eol=lf
*.md text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.gitattributes text eol=lf

# Скрипты PowerShell ожидают CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Двоичные файлы не преобразуются.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.pdf binary
*.exe binary
*.dll binary
